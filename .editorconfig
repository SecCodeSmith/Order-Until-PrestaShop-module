# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# PHP follows PSR-12 (4-space indent).
[*.php]
indent_size = 4

# Front-end assets use 2-space indent.
[*.{js,css,tpl,json,yml,yaml,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
